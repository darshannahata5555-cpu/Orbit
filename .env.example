# Copy to .env.local and fill in your Supabase project values.
# Settings → API in the Supabase dashboard.
# The anon key is safe to expose in the browser — Row-Level Security
# is what actually protects your data.
#
# If these are left blank, Orbit runs on built-in demo (mock) data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
